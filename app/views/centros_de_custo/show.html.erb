<div class="px-4 sm:px-6 lg:px-8">
  <div class="mb-6">
    <%= link_to centros_de_custo_path, class: "inline-flex items-center text-sm text-gray-500 hover:text-gray-700 mb-4" do %>
      <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
      Voltar para lista
    <% end %>
    <h1 class="text-3xl font-bold text-gray-900">Centro de Custo</h1>
  </div>

  <div class="bg-white shadow rounded-lg overflow-hidden">
    <div class="px-4 py-5 sm:p-6">
      <dl class="grid grid-cols-1 gap-x-4 gap-y-6 sm:grid-cols-2">
        <div>
          <dt class="text-sm font-medium text-gray-500">ID</dt>
          <dd class="mt-1 text-sm text-gray-900">#<%= @centro_de_custo.id %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-500">Nome</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @centro_de_custo.nome %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-500">Código</dt>
          <dd class="mt-1">
            <span class="inline-flex items-center rounded-md bg-gray-100 px-2.5 py-0.5 text-sm font-medium text-gray-800">
              <%= @centro_de_custo.codigo %>
            </span>
          </dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-500">Tipo</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @centro_de_custo.tipo || '-' %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-500">Status</dt>
          <dd class="mt-1">
            <% if @centro_de_custo.ativo %>
              <span class="inline-flex items-center rounded-full bg-green-100 px-2.5 py-0.5 text-sm font-medium text-green-800">Ativo</span>
            <% else %>
              <span class="inline-flex items-center rounded-full bg-red-100 px-2.5 py-0.5 text-sm font-medium text-red-800">Inativo</span>
            <% end %>
          </dd>
        </div>
      </dl>
    </div>
    <div class="bg-gray-50 px-4 py-4 sm:px-6 border-t border-gray-200">
      <div class="flex space-x-3">
        <%= link_to edit_centro_de_custo_path(@centro_de_custo), class: "inline-flex items-center rounded-md border border-transparent bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" do %>
          Editar
        <% end %>
      </div>
    </div>
  </div>
</div>
