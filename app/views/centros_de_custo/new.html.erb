<div class="px-4 sm:px-6 lg:px-8">
  <div class="max-w-2xl">
    <h1 class="text-3xl font-bold text-gray-900 mb-6">Novo Centro de Custo</h1>

    <% if @centro_de_custo.errors.any? %>
      <div class="mb-6 rounded-md bg-red-50 p-4">
        <div class="flex">
          <div class="flex-shrink-0">
            <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
            </svg>
          </div>
          <div class="ml-3">
            <h3 class="text-sm font-medium text-red-800">Erro ao criar centro de custo</h3>
            <div class="mt-2 text-sm text-red-700">
              <ul class="list-disc pl-5 space-y-1">
                <% @centro_de_custo.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          </div>
        </div>
      </div>
    <% end %>

    <div class="bg-white shadow rounded-lg">
      <div class="px-4 py-5 sm:p-6">
        <%= form_with model: @centro_de_custo, url: centros_de_custo_path, local: true, class: "space-y-6" do |form| %>
          <div>
            <%= form.label :nome, class: "block text-sm font-medium text-gray-700" %>
            <div class="mt-1">
              <%= form.text_field :nome, required: true, class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
            </div>
          </div>

          <div>
            <%= form.label :codigo, class: "block text-sm font-medium text-gray-700" %>
            <div class="mt-1">
              <%= form.text_field :codigo, required: true, class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" %>
            </div>
          </div>

          <div>
            <%= form.label :tipo, class: "block text-sm font-medium text-gray-700" %>
            <div class="mt-1">
              <%= form.select :tipo, options_for_select([
                ['Matrícula', 'matricula'],
                ['Mensalidade', 'mensalidade'],
                ['Material', 'material']
              ], @centro_de_custo.tipo), { include_blank: 'Selecione...' }, { class: "block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" } %>
            </div>
          </div>

          <div class="flex items-center">
            <%= form.check_box :ativo, { checked: true, class: "h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" } %>
            <%= form.label :ativo, "Ativo", class: "ml-2 block text-sm text-gray-900" %>
          </div>

          <div class="flex items-center justify-end space-x-3 pt-4 border-t border-gray-200">
            <%= link_to centros_de_custo_path, class: "inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" do %>
              Cancelar
            <% end %>
            <%= form.submit 'Criar Centro de Custo', class: "inline-flex items-center rounded-md border border-transparent bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
