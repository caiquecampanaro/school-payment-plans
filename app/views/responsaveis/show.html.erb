<div class="px-4 sm:px-6 lg:px-8">
  <div class="mb-6">
    <%= link_to responsaveis_path, class: "inline-flex items-center text-sm text-gray-500 hover:text-gray-700 mb-4" do %>
      <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
      Voltar para lista
    <% end %>
    <h1 class="text-3xl font-bold text-gray-900">Responsável Financeiro</h1>
  </div>

  <div class="bg-white shadow rounded-lg overflow-hidden">
    <div class="px-4 py-5 sm:p-6">
      <dl class="grid grid-cols-1 gap-x-4 gap-y-6 sm:grid-cols-2">
        <div>
          <dt class="text-sm font-medium text-gray-500">ID</dt>
          <dd class="mt-1 text-sm text-gray-900">#<%= @responsavel.id %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-500">Nome</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @responsavel.nome %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-500">Identificador</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @responsavel.identificador %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-500">Criado em</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @responsavel.created_at.strftime('%d/%m/%Y às %H:%M') %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-gray-500">Atualizado em</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @responsavel.updated_at.strftime('%d/%m/%Y às %H:%M') %></dd>
        </div>
      </dl>
    </div>
    <div class="bg-gray-50 px-4 py-4 sm:px-6 border-t border-gray-200">
      <div class="flex space-x-3">
        <%= link_to responsavel_planos_pagamento_path(@responsavel), class: "inline-flex items-center rounded-md border border-transparent bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" do %>
          Ver Planos
        <% end %>
        <%= link_to responsavel_cobrancas_path(@responsavel), class: "inline-flex items-center rounded-md border border-transparent bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" do %>
          Ver Cobranças
        <% end %>
      </div>
    </div>
  </div>
</div>
