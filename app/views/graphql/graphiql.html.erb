<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= form_authenticity_token %>">
  <title>GraphQL Playground - Kedu</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    .graphql-container {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
      height: 500px;
      min-height: 400px;
    }
    .graphql-container > div {
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    .graphql-container textarea {
      flex: 1;
      min-height: 0;
      resize: none;
    }
    .graphql-container pre {
      flex: 1;
      min-height: 0;
      overflow-y: auto;
      overflow-x: auto;
      max-height: 100%;
    }
    @media (max-width: 768px) {
      .graphql-container {
        grid-template-columns: 1fr;
        height: auto;
        min-height: 300px;
      }
    }
    textarea, pre {
      font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', monospace;
      font-size: 14px;
    }
    .copy-btn {
      transition: all 0.2s;
    }
    .copy-btn:hover {
      transform: scale(1.1);
    }
    .copy-btn.copied {
      background-color: #10b981 !important;
    }
  </style>
</head>
<body class="bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <div class="mb-6">
      <h1 class="text-3xl font-bold text-gray-900 mb-2">GraphQL Playground</h1>
      <p class="text-sm text-gray-600">Teste suas queries e mutations GraphQL</p>
    </div>

    <div class="bg-white shadow rounded-lg p-6 mb-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">📚 Exemplos de Queries</h2>
      <div class="space-y-4">
        <div class="border-l-4 border-indigo-500 pl-4 bg-gray-50 rounded-r-lg p-4">
          <div class="flex items-center justify-between mb-2">
            <h3 class="text-sm font-medium text-gray-900">Listar Centros de Custo</h3>
            <button onclick="copiarExemplo(this)" class="copy-btn inline-flex items-center rounded-md border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
              <svg class="h-4 w-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
              </svg>
              Copiar
            </button>
          </div>
          <pre class="bg-gray-900 text-green-400 p-3 rounded text-xs overflow-x-auto"><code>query {
  centrosDeCusto {
    id
    nome
    codigo
    tipo
    ativo
  }
}</code></pre>
        </div>

        <div class="border-l-4 border-indigo-500 pl-4 bg-gray-50 rounded-r-lg p-4">
          <div class="flex items-center justify-between mb-2">
            <h3 class="text-sm font-medium text-gray-900">Consultar Plano de Pagamento</h3>
            <button onclick="copiarExemplo(this)" class="copy-btn inline-flex items-center rounded-md border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
              <svg class="h-4 w-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
              </svg>
              Copiar
            </button>
          </div>
          <pre class="bg-gray-900 text-green-400 p-3 rounded text-xs overflow-x-auto"><code>query {
  planoPagamento(id: "4") {
    id
    valorTotal
    responsavelFinanceiro {
      nome
      identificador
    }
    centroDeCusto {
      nome
      codigo
    }
    cobrancas {
      id
      valor
      dataVencimento
      metodoPagamento
      status
      codigoPagamento
      vencida
    }
  }
}</code></pre>
        </div>

        <div class="border-l-4 border-indigo-500 pl-4 bg-gray-50 rounded-r-lg p-4">
          <div class="flex items-center justify-between mb-2">
            <h3 class="text-sm font-medium text-gray-900">Listar Planos de um Responsável</h3>
            <button onclick="copiarExemplo(this)" class="copy-btn inline-flex items-center rounded-md border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
              <svg class="h-4 w-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
              </svg>
              Copiar
            </button>
          </div>
          <pre class="bg-gray-900 text-green-400 p-3 rounded text-xs overflow-x-auto"><code>query {
  planosPagamento(responsavelId: "1") {
    id
    valorTotal
    centroDeCusto {
      nome
    }
    cobrancas {
      valor
      status
    }
  }
}</code></pre>
        </div>

        <div class="border-l-4 border-indigo-500 pl-4 bg-gray-50 rounded-r-lg p-4">
          <div class="flex items-center justify-between mb-2">
            <h3 class="text-sm font-medium text-gray-900">Listar Cobranças de um Responsável</h3>
            <button onclick="copiarExemplo(this)" class="copy-btn inline-flex items-center rounded-md border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
              <svg class="h-4 w-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
              </svg>
              Copiar
            </button>
          </div>
          <pre class="bg-gray-900 text-green-400 p-3 rounded text-xs overflow-x-auto"><code>query {
  cobrancas(responsavelId: "1") {
    id
    valor
    dataVencimento
    metodoPagamento
    status
    codigoPagamento
    vencida
    planoPagamento {
      id
    }
  }
}</code></pre>
        </div>

        <div class="border-l-4 border-indigo-500 pl-4 bg-gray-50 rounded-r-lg p-4">
          <div class="flex items-center justify-between mb-2">
            <h3 class="text-sm font-medium text-gray-900">Quantidade de Cobranças</h3>
            <button onclick="copiarExemplo(this)" class="copy-btn inline-flex items-center rounded-md border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
              <svg class="h-4 w-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
              </svg>
              Copiar
            </button>
          </div>
          <pre class="bg-gray-900 text-green-400 p-3 rounded text-xs overflow-x-auto"><code>query {
  cobrancasQuantidade(responsavelId: "1")
}</code></pre>
        </div>
      </div>
    </div>

    <div class="bg-white shadow rounded-lg p-6 mb-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">✏️ Exemplos de Mutations</h2>
      <div class="space-y-4">
        <div class="border-l-4 border-green-500 pl-4 bg-gray-50 rounded-r-lg p-4">
          <div class="flex items-center justify-between mb-2">
            <h3 class="text-sm font-medium text-gray-900">Criar Responsável</h3>
            <button onclick="copiarExemplo(this)" class="copy-btn inline-flex items-center rounded-md border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
              <svg class="h-4 w-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
              </svg>
              Copiar
            </button>
          </div>
          <pre class="bg-gray-900 text-green-400 p-3 rounded text-xs overflow-x-auto"><code>mutation {
  criarResponsavel(
    nome: "João Silva"
    identificador: "12345678900"
  ) {
    id
    nome
  }
}</code></pre>
        </div>

        <div class="border-l-4 border-green-500 pl-4 bg-gray-50 rounded-r-lg p-4">
          <div class="flex items-center justify-between mb-2">
            <h3 class="text-sm font-medium text-gray-900">Criar Centro de Custo</h3>
            <button onclick="copiarExemplo(this)" class="copy-btn inline-flex items-center rounded-md border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
              <svg class="h-4 w-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
              </svg>
              Copiar
            </button>
          </div>
          <pre class="bg-gray-900 text-green-400 p-3 rounded text-xs overflow-x-auto"><code>mutation {
  criarCentroDeCusto(
    nome: "Matrícula"
    codigo: "MATRICULA"
    tipo: "matricula"
  ) {
    id
    nome
    codigo
  }
}</code></pre>
        </div>

        <div class="border-l-4 border-green-500 pl-4 bg-gray-50 rounded-r-lg p-4">
          <div class="flex items-center justify-between mb-2">
            <h3 class="text-sm font-medium text-gray-900">Criar Plano de Pagamento</h3>
            <button onclick="copiarExemplo(this)" class="copy-btn inline-flex items-center rounded-md border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
              <svg class="h-4 w-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
              </svg>
              Copiar
            </button>
          </div>
          <pre class="bg-gray-900 text-green-400 p-3 rounded text-xs overflow-x-auto"><code>mutation {
  criarPlanoPagamento(
    responsavelId: "1"
    centroDeCustoId: "1"
    cobrancas: [
      {
        valor: 500.00
        dataVencimento: "2025-03-10"
        metodoPagamento: BOLETO
      }
    ]
  ) {
    id
    valorTotal
    cobrancas {
      id
      codigoPagamento
    }
  }
}</code></pre>
        </div>

        <div class="border-l-4 border-green-500 pl-4 bg-gray-50 rounded-r-lg p-4">
          <div class="flex items-center justify-between mb-2">
            <h3 class="text-sm font-medium text-gray-900">Registrar Pagamento</h3>
            <button onclick="copiarExemplo(this)" class="copy-btn inline-flex items-center rounded-md border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
              <svg class="h-4 w-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
              </svg>
              Copiar
            </button>
          </div>
          <pre class="bg-gray-900 text-green-400 p-3 rounded text-xs overflow-x-auto"><code>mutation {
  registrarPagamento(
    cobrancaId: "1"
    valor: 500.00
    dataPagamento: "2025-03-10"
  ) {
    id
    valor
    dataPagamento
    cobranca {
      status
    }
  }
}</code></pre>
        </div>
      </div>
    </div>

    <div class="bg-white shadow rounded-lg p-6">
      <h2 class="text-lg font-semibold text-gray-900 mb-4">Editor GraphQL</h2>
      <div class="graphql-container">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Query / Mutation</label>
          <textarea id="query" class="w-full h-full p-4 border border-gray-300 rounded-md focus:ring-indigo-500 focus:border-indigo-500" placeholder="Digite sua query ou mutation aqui...">query {
  responsaveis {
    id
    nome
  }
}</textarea>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Resposta</label>
          <pre id="response" class="w-full p-4 border border-gray-300 rounded-md bg-gray-50 text-xs" style="height: 100%; overflow-y: auto; overflow-x: auto;">Aguardando execução...</pre>
        </div>
      </div>
      <div class="mt-4 flex items-center justify-end space-x-3">
        <button onclick="executarQuery()" class="inline-flex items-center rounded-md border border-transparent bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
          <svg class="-ml-1 mr-2 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          Executar
        </button>
        <button onclick="limpar()" class="inline-flex items-center rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
          Limpar
        </button>
      </div>
    </div>
  </div>

  <script>
    function copiarExemplo(button) {
      const exampleItem = button.closest('.border-l-4');
      const code = exampleItem.querySelector('code').textContent;
      document.getElementById('query').value = code;
      
      // Feedback visual
      const originalText = button.innerHTML;
      button.classList.add('copied');
      button.innerHTML = '<svg class="h-4 w-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>Copiado!';
      
      setTimeout(() => {
        button.classList.remove('copied');
        button.innerHTML = originalText;
      }, 2000);
    }

    function executarQuery() {
      const query = document.getElementById('query').value;
      const responseEl = document.getElementById('response');
      
      if (!query.trim()) {
        responseEl.textContent = 'Erro: Por favor, digite uma query ou mutation.';
        return;
      }
      
      responseEl.textContent = 'Executando...';
      
      fetch('/graphql', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content || ''
        },
        body: JSON.stringify({
          query: query
        })
      })
      .then(response => response.json())
      .then(data => {
        responseEl.textContent = JSON.stringify(data, null, 2);
      })
      .catch(error => {
        responseEl.textContent = 'Erro: ' + error.message;
      });
    }

    function limpar() {
      document.getElementById('query').value = '';
      document.getElementById('response').textContent = 'Aguardando execução...';
    }
  </script>
</body>
</html>
